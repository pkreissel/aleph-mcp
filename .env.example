# Aleph instance to query. Defaults to https://search.openaleph.org, which
# serves anonymous requests. Point it at any other Aleph instance you use.
ALEPH_HOST=https://search.openaleph.org

# API key for that instance, from your profile page there under "API Key".
# Leave empty for an instance that answers anonymously; most instances need it
# for everything except /api/2/metadata.
ALEPH_API_KEY=

# Optional: DEBUG, INFO, WARNING (default), ERROR.
ALEPH_MCP_LOG_LEVEL=WARNING
